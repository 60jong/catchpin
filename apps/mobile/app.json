{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.catchpin.mobile"
    },
    "android": {
      "package": "com.catchpin.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-font",
      "expo-notifications",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 고르려면 사진 보관함에 접근해야 해요.",
          "cameraPermission": "프로필 사진을 찍으려면 카메라에 접근해야 해요.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ],
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "c13c548bd8c60d2ee12a05b87f798503"
        }
      ],
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2628381420614049~8716988959"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://catchpin.60jong.dev",
      "admobRewardedUnitId": "ca-app-pub-2628381420614049/2738738117",
      "admobTestAds": true,
      "googleWebClientId": "534259490222-u8921g1s80eheung7a29hiu67aqi0jkq.apps.googleusercontent.com",
      "googleIosClientId": "534259490222-j0ro68i7a706dsstjho20dnuteel3irk.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "505ab1cf-a098-4f55-b546-88884fc67ce3"
      }
    },
    "owner": "60jong"
  }
}
